{
  "manifest_version": 3,
  "name": "TARUMT Intranet Beautifier",
  "description": "A modern, accessible look for the TAR UMT Student Intranet and Course Registration Portal, with light and dark themes.",
  "version": "2.0.0",
  "author": "devalston390@gmail.com",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TARUMT Intranet Beautifier",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.tarc.edu.my/*", "https://reg.tarc.edu.my/*"],
      "run_at": "document_start",
      "all_frames": true,
      "js": ["src/settings.js", "src/theme.js"],
      "css": [
        "src/styles/tokens.css",
        "src/styles/base.css",
        "src/styles/login.css",
        "src/styles/layout.css",
        "src/styles/components.css"
      ]
    }
  ]
}
